[run]
branch = True
source = .
omit =
    test_*.py
    tests/*
    # SpaceLapse tools have their own tests (tests/test_release_index.py)
    tools/build_index.py
    tools/build_tracks.py
    tools/validate_targets.py

[report]
show_missing = True
fail_under = 90
exclude_also =
    if __name__ == .__main__.:
